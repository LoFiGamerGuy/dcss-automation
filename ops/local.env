# ops/local.env — local-model overnight profile.
#
# Sourced by ops/overnight.sh BEFORE ops/config.env, which then fills in
# anything left unset via ${VAR:-default}. Read
# docs/decisions/003-local-model-overnight.md for why this profile is shaped
# the way it is — several settings here are workarounds for defects that fail
# silently, not preferences.

# ---- LM Studio (runs on the Windows host, outside this distro) --------------
# Empty LMSTUDIO_HOST = auto-detect the WSL default gateway at runtime. Do not
# hardcode it: WSL is in NAT mode, so the address changes across restarts.
LMSTUDIO_HOST="${LMSTUDIO_HOST:-}"
LMSTUDIO_PORT="${LMSTUDIO_PORT:-1234}"
LMSTUDIO_MODEL="${LMSTUDIO_MODEL:-qwen/qwen3.6-35b-a3b}"

# ---- LiteLLM gateway (runs inside this distro, loopback only) ---------------
# Translates Claude Code's Anthropic /v1/messages into LM Studio's OpenAI API.
GATEWAY_PORT="${GATEWAY_PORT:-4000}"
GATEWAY_KEY="${GATEWAY_KEY:-sk-local-dcss}"
GATEWAY_VENV="${GATEWAY_VENV:-$HOME/venvs/litellm}"

# ---- Overnight profile ------------------------------------------------------
# The worker runs on the local model; the orchestrator stays on Fable.
export WORKER_MODEL="local-worker"
export WORKER_BASE_URL="http://127.0.0.1:${GATEWAY_PORT}"
export WORKER_AUTH_TOKEN="${GATEWAY_KEY}"
export WORKER_SMALL_MODEL="local-worker"

export ORCH_MODEL="fable"

# The model's REAL context window (LM Studio reports it via `lms ps`).
# Claude Code assumes 200k for a model name it doesn't recognize, so without
# this it won't compact until long after the backend has already overflowed.
LOCAL_CONTEXT_TOKENS="${LOCAL_CONTEXT_TOKENS:-64000}"
export WORKER_CONTEXT_TOKENS="$LOCAL_CONTEXT_TOKENS"

# Check in more often than the cloud profile's 8. A weaker worker drifts faster,
# and the orchestrator is the only thing that catches it.
export ORCH_EVERY="${ORCH_EVERY:-4}"

# A 35B model has far less usable context than Claude. Cap turns so an
# iteration ends and journals cleanly instead of overflowing context mid-task.
export MAX_TURNS="${MAX_TURNS:-40}"
export ITER_TIMEOUT="${ITER_TIMEOUT:-3600}"

# Stop on its own by morning.
export MAX_RUNTIME_HOURS="${MAX_RUNTIME_HOURS:-10}"

# Halt sooner than the cloud profile: repeated no-commit iterations from a local
# model usually means it cannot drive the tool loop, and more attempts won't fix
# that.
export STALL_HALT="${STALL_HALT:-4}"
