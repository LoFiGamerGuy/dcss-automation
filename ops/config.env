# ops/config.env — supervisor configuration.
#
# Every value uses ${VAR:-default}, so anything exported before sourcing this
# file wins. That is how ops/overnight.sh swaps the worker onto a local model
# without editing anything here.

# ---- Models -----------------------------------------------------------------
# Aliases: haiku | sonnet | opus | fable, a full model id, or a gateway
# model_name when WORKER_BASE_URL is set.
#
# Phase 0 (pinning crawl+qw commits, debugging the DGL_MILESTONES build) is the
# hardest part of the project — sonnet is the sane default here.
WORKER_MODEL="${WORKER_MODEL:-sonnet}"

# The periodic review pass. This is where you want strength; it is also the
# only thing checking the worker's homework, so do not cheap out on it.
ORCH_MODEL="${ORCH_MODEL:-fable}"

# Run the orchestrator every N iterations. 0 disables the periodic pass
# (stall-triggered escalation still fires). Lower this when the worker is on a
# weaker model.
ORCH_EVERY="${ORCH_EVERY:-8}"

# ---- Per-role routing -------------------------------------------------------
# ANTHROPIC_BASE_URL is process-global, so the supervisor applies these
# per invocation rather than exporting them once. Leaving WORKER_BASE_URL empty
# means the worker uses normal Claude Code auth.
#
# The orchestrator ALWAYS runs with these unset, so it reaches the real Claude
# API even while the worker is routed to a local gateway.
WORKER_BASE_URL="${WORKER_BASE_URL:-}"
WORKER_AUTH_TOKEN="${WORKER_AUTH_TOKEN:-}"
WORKER_SMALL_MODEL="${WORKER_SMALL_MODEL:-}"

# Real context window of the worker model, when it is one Claude Code does not
# recognize. Empty = let Claude Code decide.
WORKER_CONTEXT_TOKENS="${WORKER_CONTEXT_TOKENS:-}"

# ---- Brakes -----------------------------------------------------------------
# Hard cap on iterations. 0 = unlimited.
MAX_ITERATIONS="${MAX_ITERATIONS:-0}"

# Halt after this many hours of wall clock. 0 = no deadline. Set this for
# overnight runs so the loop stops on its own.
MAX_RUNTIME_HOURS="${MAX_RUNTIME_HOURS:-0}"

# Wall-clock cap per iteration. Campaigns run detached, so no single iteration
# should need hours.
ITER_TIMEOUT="${ITER_TIMEOUT:-5400}"       # seconds (90 min)

# Agentic turn cap per iteration. Empty = unlimited. Lower this for
# small-context local models so an iteration ends before it overflows context.
MAX_TURNS="${MAX_TURNS:-}"

# Consecutive commitless iterations before escalating to the orchestrator.
STALL_ESCALATE="${STALL_ESCALATE:-2}"

# Consecutive commitless iterations before halting entirely.
STALL_HALT="${STALL_HALT:-5}"

# Sleep between iterations, and the ceiling for exponential backoff on error.
SLEEP_BASE="${SLEEP_BASE:-30}"             # seconds
SLEEP_MAX="${SLEEP_MAX:-1800}"             # seconds (30 min)
