# ops/config.env — supervisor configuration. Edit here, not in supervise.sh.

# ---- Models -----------------------------------------------------------------
# Aliases: haiku | sonnet | opus | fable  (or a full model id)
#
# WORKER_MODEL grinds the implementation. Phase 0 (pinning crawl+qw commits,
# debugging the DGL_MILESTONES build) is genuinely hard — start on sonnet.
# Once Phase 1 is mechanical (collector, reports, drills), haiku is worth
# trying for cost; watch the journal quality for a few iterations after you
# switch, and revert if entries get thin.
WORKER_MODEL="sonnet"

# ORCH_MODEL runs the periodic review pass. This is where you want strength.
ORCH_MODEL="fable"

# Run the orchestrator every N worker iterations. 0 disables the periodic pass
# (stall-triggered escalation still fires).
ORCH_EVERY=8

# ---- Optional: route through a local/self-hosted gateway --------------------
# Leave empty for normal Claude Code auth (recommended).
#
# Setting these points Claude Code at an Anthropic-format endpoint. Note that
# Anthropic does not support routing Claude Code to non-Claude models through
# any gateway, and this workload — days of unattended, tool-call-heavy agentic
# work — is where weak tool-calling fails silently rather than erroring out.
# If you try it, run a few supervised iterations and read the logs before
# trusting it overnight.
export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-}"
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-}"
[ -z "${ANTHROPIC_BASE_URL:-}" ] && unset ANTHROPIC_BASE_URL
[ -z "${ANTHROPIC_AUTH_TOKEN:-}" ] && unset ANTHROPIC_AUTH_TOKEN

# ---- Brakes -----------------------------------------------------------------
# Hard cap on iterations. 0 = unlimited (the "continuous until blocked" mode).
MAX_ITERATIONS=0

# Wall-clock cap per iteration. An invocation that exceeds this is interrupted;
# the campaign itself runs detached, so no single iteration should need hours.
ITER_TIMEOUT=5400          # seconds (90 min)

# Agentic turn cap per iteration. Empty = unlimited.
MAX_TURNS=""

# Consecutive iterations with no new commit before escalating to the
# orchestrator to diagnose the stall.
STALL_ESCALATE=2

# Consecutive iterations with no new commit before halting entirely.
STALL_HALT=5

# Sleep between iterations, and the ceiling for exponential backoff on error.
SLEEP_BASE=30              # seconds
SLEEP_MAX=1800             # seconds (30 min)
