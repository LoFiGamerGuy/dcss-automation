# Generated per-run campaign rc — do not hand-edit, see ops/rc-gen.py.
# Loads qw's own rc unmodified, then its bot logic (qw.rc's own
# `include = qw.lua` line ships commented out, see README.md "Method 1"),
# then overrides just what a campaign run needs: non-interactive, full-speed
# start on a specific sampled combo.
#
# c_persist (qw's cross-game memory, §7 of PLAN.md) is not explicitly cleared
# here — it doesn't need to be. crawl's clua persist API keys it to the save
# under -dir/-name, and every run gets its own freshly created, unique -dir
# and -name (ops/rc-gen.py / the runner never reuses either across runs), so
# each run starts with an empty c_persist by construction.
include = qw.rc
include = qw.lua

: AUTO_START = true
: DELAYED = false
combo = __COMBO__

# Phase 2 A/B flag (docs/decisions/011): guards two qw upstream Lua crash
# fixes (equipment.lua's cur_equip boolean-index, plans-rest.lua's
# hostile_servants_timer nil-arithmetic). Default/unset behaves as true
# (fixes applied); __BUGFIX_LUA_ERRORS__ of "false" reproduces the original
# crashes, for the experiment's control arm.
: QW_BUGFIX_LUA_ERRORS = __BUGFIX_LUA_ERRORS__

# Phase 2 A/B flag (docs/decisions/012): guards plans-rest.lua's
# should_rest()/reason_to_rest() indefinite-talisman-transform stall (every
# Shapeshifter -- and any character permanently transformed via a talisman
# -- picked plans.rest every tick forever instead of ever exploring).
# Default/unset behaves as true (fix applied); __BUGFIX_INDEFINITE_TRANSFORM__
# of "false" reproduces the original stall, for the experiment's control arm.
: QW_BUGFIX_INDEFINITE_TRANSFORM = __BUGFIX_INDEFINITE_TRANSFORM__

# Harness-enforced turn budget (PLAN.md §6 timeout_turns) — distinct from
# qw's own QUIT_TURNS "stuck" detection (line ~103 of qw.rc, that's
# quit_stuck). clua has no io/os library (clua.cc: LUA_IOLIBNAME/OSLIBNAME
# are commented out of the loaded lib list) so this can't write a marker
# file from inside the game; it wraps qw's own ready() hook instead (must
# come after `include = qw.lua` above, since ready() must already exist to
# wrap) and, when the budget is hit, prints an on-screen sentinel via
# crawl.mpr — visible in the captured pty output, same channel runner.py
# already scans for error patterns.
#
# Deliberately does NOT also send the Ctrl-Q "yes" quit sequence from here:
# an earlier version tried that with magic()/crawl.process_keys, and it hung
# — the quit keys got queued into the same in-process macro buffer qw's own
# ready() is concurrently feeding movement/action keys into every tick, and
# the two interleaved unpredictably (confirmed by hand: the sentinel fired
# but the process never reached EOF). Sending keys is therefore runner.py's
# job once it observes the sentinel in the pty stream — that's the same
# external channel a human (or qw's own util/qw.exp) types into, so it can't
# race qw's internal queueing. __TURN_BUDGET__ of 0 disables this (used by
# tests that don't want turn-budget behavior in scope).
: TURN_BUDGET = __TURN_BUDGET__
{
local harness_orig_ready = ready
local harness_budget_fired = false
function ready()
    harness_orig_ready()
    if TURN_BUDGET and TURN_BUDGET > 0 and not harness_budget_fired
            and you.turns() >= TURN_BUDGET then
        harness_budget_fired = true
        crawl.mpr("HARNESS_TIMEOUT_TURNS turns=" .. you.turns())
    end
end
}
