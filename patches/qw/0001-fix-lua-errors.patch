+-- hostile_servants_timer is referenced below but never assigned anywhere in
+-- qw's source (grepped the whole tree) -- an orphaned global, presumably
+-- left behind by a removed or renamed Makhleb-ally-timer feature. Every
+-- Makhleb worshipper crashed here ("attempt to perform arithmetic on
+-- global 'hostile_servants_timer' (a nil value)") the first time
+-- should_rest() ran. Confirmed live via the phase1-500 campaign and the
+-- dlua console; see docs/decisions/011. QW_BUGFIX_LUA_ERRORS (rc-settable,
+-- default true/unset) can be set to false to disable this guard and
+-- reproduce the original crash, for the Phase 2 A/B experiment's control
+-- arm.
+function qw_hostile_servants_timer()
+    if QW_BUGFIX_LUA_ERRORS == false then
+        return hostile_servants_timer
+    end
+    return hostile_servants_timer or 0
+end
+
 function should_rest()
     if qw.danger_in_los and not qw.all_enemies_safe or qw.position_is_cloudy then
         return false
@@ -45,7 +62,7 @@ function should_rest()
     return you.berserk()
         or you.turns() < hiding_turn_count + 10
         or you.god() == "Makhleb"
-            and you.turns() <= hostile_servants_timer + 100
+            and you.turns() <= qw_hostile_servants_timer() + 100
         or reason_to_rest(99.9)
 end
 
